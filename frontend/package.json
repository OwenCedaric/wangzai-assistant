    "format:check": "prettier --check \"*.config.js\" \"tsconfig*.json\" \"src/app/**/*.{js,jsx}\" \"src/features/**/*.{js,jsx}\" \"src/shared/**/*.{js,jsx}\" \"src/entities/**/*.{js,jsx}\" \"src/services/safeLog.js\" \"src/services/ozonOrderSafety.js\" \"src/services/ozonRequestControl.js\" \"src/services/requestCooldown.js\" \"src/services/*.test.js\" \"src/test/setup.js\" \"src/test/**/*.{js,jsx}\" \"scripts/scan-secrets.mjs\"",
