    "test:v2-ui-stress": "vitest run src/test/v2CloudUiControlCoverage.test.jsx",
    "check": "npm run security:scan && npm run check:architecture && npm run check:global-structure && npm run check:profit-freeze && npm run check:profit-review-freeze && npm run check:product-selection-freeze && npm run check:purchase-pdd-route-freeze && npm run check:data-analysis-insight-freeze && npm run check:data-analysis-market-capture-freeze && npm run check:product-image-oss-freeze && npm run check:follow-seller-scheme1-freeze && npm run test:architecture && npm run lint && npm run typecheck && npm run test && npm run build",
