# Public DNS name. Point its A/AAAA record at this server before startup.
LICENSE_DOMAIN=license.example.com
POSTGRES_PASSWORD=replace-with-generated-url-safe-password

# Recommended for one 4-vCPU/8-GiB production node. Keep PostgreSQL + Redis +
# Caddy on the same private Docker network; only TCP 80/443 and UDP 443 are public.
# Light API role (login, heartbeat, points, admin). Raise workers first when many
# clients are online; keep sum(workers x (pool + overflow)) of all roles < 100.
BACKEND_WORKERS=4
BACKEND_DB_POOL_SIZE=5
BACKEND_DB_MAX_OVERFLOW=5
BACKEND_MEM_LIMIT=1g
# Heavy API role (AI models, cross-border, profit compute, recovery uploads). Its
# threads mostly wait on third-party services, so threads > DB connections is fine.
HEAVY_BACKEND_WORKERS=2
HEAVY_DB_POOL_SIZE=10
HEAVY_DB_MAX_OVERFLOW=10
HEAVY_THREADPOOL_TOKENS=100
HEAVY_BACKEND_MEM_LIMIT=2g
WORKER_MEM_LIMIT=512m
BACKEND_KEEP_ALIVE_SECONDS=10
SMART_REPLY_WORKER_INTERVAL_SECONDS=5
CROSS_BORDER_API_BASE_URL=https://api.service.kuajing84.com
CROSS_BORDER_COMPANY_SECRET_FILE=/run/secrets/cross_border_company_secret
CROSS_BORDER_TOKEN_STATE_FILE=/tmp/cross-border-enterprise-token.enc
CROSS_BORDER_GRANT_TTL_SECONDS=2592000
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=2GB
POSTGRES_WORK_MEM=8MB
REDIS_MAXMEMORY=512mb

APP_NAME=License Center
JWT_ISSUER=license-center
JWT_AUDIENCE=license-center-clients
OFFLINE_SIGNING_KEY_ID=license-center-v1
PROTECTED_COMPUTE_SIGNING_KEY_ID=protected-compute-v1
PROTECTED_COMPUTE_RESULT_TTL_SECONDS=300
PROTECTED_COMPUTE_RATE_LIMIT_PER_MINUTE=60
PROTECTED_COMPUTE_REVOCATION_EPOCH=0
PROTECTED_COMPUTE_REVOKED_KEY_IDS=
PROTECTED_COMPUTE_REVOKED_CAPABILITIES=
PAID_CAPABILITY_ENABLED=false
PAID_CAPABILITY_QUOTE_TTL_SECONDS=120
PAID_CAPABILITY_REQUEST_SKEW_SECONDS=60
PAID_CAPABILITY_RATE_LIMIT_PER_MINUTE=60
PAID_TEXT_BASE_URL=https://api.openai.com/v1
PAID_IMAGE_BASE_URL=https://images.example.invalid/v1
PAID_SEERFAR_BASE_URL=https://api.seerfar.cn
PAID_PROVIDER_ALLOWED_HOSTS=api.openai.com,api.seerfar.cn
# Replace with the exact private OSS/CDN hosts used for image-edit source URLs.
PAID_SOURCE_IMAGE_ALLOWED_HOSTS=
PAID_PROVIDER_TIMEOUT_SECONDS=150
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
LICENSE_TOKEN_HOURS=24
OFFLINE_GRACE_HOURS=72
ORDER_EXPIRY_MINUTES=15
PAYMENT_QUERY_RATE_LIMIT_PER_MINUTE=20
COMMISSION_HOLD_DAYS=7

# Set both only for the first deployment, then remove them after the admin exists.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# SMS must be a real provider in production. Aliyun is fully implemented.
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY=replace-with-aliyun-access-key-id
SMS_SECRET_KEY_FILE=/run/secrets/sms_secret_key
SMS_SIGN_NAME=replace-with-approved-sms-sign-name
SMS_TEMPLATE_CODE=replace-with-approved-template-code
SMS_EXPOSE_DEVELOPMENT_CODE=false
OTP_TTL_SECONDS=300
OTP_SEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_ATTEMPTS=5

# Development payment is always disabled in production.
PAYMENT_DEFAULT_PROVIDER=wechat
PAYMENT_GATEWAY_MODE=jeepay
PAYMENT_DEVELOPMENT_ENABLED=false

# Recommended aggregate gateway. The API key is a Jeepay merchant application
# key, not an Alipay/WeChat private key, and must be mounted as a secret file.
JEEPAY_ENABLED=true
# Turn on only the channel that has completed live payment and refund acceptance.
JEEPAY_ALIPAY_ENABLED=false
JEEPAY_WECHAT_ENABLED=false
JEEPAY_API_BASE_URL=https://pay-api.example.com
JEEPAY_MCH_NO=
JEEPAY_APP_ID=
JEEPAY_API_KEY_FILE=/run/secrets/jeepay_api_key
JEEPAY_NOTIFY_URL=https://license.example.com/api/payments/jeepay/notify
JEEPAY_REFUND_NOTIFY_URL=https://license.example.com/api/payments/jeepay/refund-notify
JEEPAY_ALIPAY_WAY_CODE=ALI_QR
JEEPAY_WECHAT_WAY_CODE=WX_NATIVE
JEEPAY_CALLBACK_MAX_AGE_SECONDS=600

# Direct WeChat Pay Native fallback. Used only when PAYMENT_GATEWAY_MODE=direct.
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_MERCHANT_SERIAL_NO=
WECHAT_API_V3_KEY_FILE=
WECHAT_PRIVATE_KEY_FILE=
WECHAT_PLATFORM_CERTIFICATE_FILE=
WECHAT_NOTIFY_URL=https://license.example.com/api/payments/wechat/notify
WECHAT_REFUND_NOTIFY_URL=https://license.example.com/api/payments/wechat/refund-notify

# Direct Alipay precreate fallback. Used only when PAYMENT_GATEWAY_MODE=direct.
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_PKCS_KEY_FILE=/run/secrets/alipay_production_private_pkcs_key
ALIPAY_ALIPAY_PUBLIC_KEY_FILE=/run/secrets/alipay_production_alipay_public_key
ALIPAY_PRIVATE_KEY_FILE=
ALIPAY_PUBLIC_KEY_FILE=
ALIPAY_NOTIFY_URL=https://license.example.com/api/payments/alipay/notify

AUTH_RATE_LIMIT_PER_MINUTE=30
LICENSE_RATE_LIMIT_PER_MINUTE=120
SMS_IP_RATE_LIMIT_PER_MINUTE=30
SMS_DEVICE_RATE_LIMIT_PER_MINUTE=10
ONLINE_WINDOW_MINUTES=390
