{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://license-center.local/schemas/project-v1.json",
  "title": "License Center project.json v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "code", "version", "modules"],
  "properties": {
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "code": {
      "type": "string",
      "minLength": 2,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "version": {"type": "string", "minLength": 1, "maxLength": 32},
    "version_hash": {"type": ["string", "null"], "maxLength": 128},
    "description": {"type": ["string", "null"], "maxLength": 2000},
    "modules": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1, "maxLength": 128},
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "name"],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 2,
                "maxLength": 96,
                "pattern": "^[a-z][a-z0-9_.-]*$"
              },
              "name": {"type": "string", "minLength": 1, "maxLength": 128},
              "description": {"type": ["string", "null"], "maxLength": 1000}
            }
          }
        ]
      }
    }
  }
}
