APP_NAME=License Center
APP_ENV=development
DEBUG=false
OZON_NOTIFICATION_CALLBACK_TOKEN=
OZON_NOTIFICATION_CALLBACK_TOKEN_FILE=
OZON_NOTIFICATION_SINK_URL=http://127.0.0.1:3790/api/internal/ozon/push-notifications
OZON_NOTIFICATION_SINK_SECRET_FILE=
SMART_REPLY_WORKER_INTERVAL_SECONDS=5
CROSS_BORDER_API_BASE_URL=https://api.service.kuajing84.com
CROSS_BORDER_COMPANY_SECRET_FILE=.runtime/cross-border-company-secret
CROSS_BORDER_TOKEN_STATE_FILE=.runtime/cross-border-enterprise-token.enc
CROSS_BORDER_GRANT_TTL_SECONDS=2592000
DOCS_ENABLED=true
DATABASE_URL=postgresql+psycopg://license_center:license_center@localhost:5432/license_center
SQL_ECHO=false
AUTO_CREATE_TABLES=false
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false

# Development values only. Production must replace these or use the *_FILE variants.
JWT_SECRET_KEY=development-jwt-secret-replace-before-production
JWT_SECRET_KEY_FILE=
JWT_ALGORITHM=HS256
JWT_ISSUER=license-center
JWT_AUDIENCE=license-center-clients
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
LICENSE_TOKEN_HOURS=24
OFFLINE_GRACE_HOURS=72

CARD_HASH_SECRET=development-card-hash-secret-replace-before-production
CARD_HASH_SECRET_FILE=
CARD_ENCRYPTION_KEY=
CARD_ENCRYPTION_KEY_FILE=

IDENTITY_HASH_SECRET=development-identity-hash-secret-replace-production
IDENTITY_HASH_SECRET_FILE=
IDENTITY_ENCRYPTION_KEY=
IDENTITY_ENCRYPTION_KEY_FILE=
OTP_HASH_SECRET=development-otp-hash-secret-replace-before-production
OTP_HASH_SECRET_FILE=
REFRESH_TOKEN_SECRET=development-refresh-secret-replace-before-production
REFRESH_TOKEN_SECRET_FILE=
CHANNEL_TOKEN_SECRET=development-channel-secret-replace-before-production
CHANNEL_TOKEN_SECRET_FILE=

# development | aliyun | tencent (Tencent adapter currently fail-closed)
SMS_PROVIDER=development
SMS_DEVELOPMENT_CODE=123456
SMS_EXPOSE_DEVELOPMENT_CODE=true
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SECRET_KEY_FILE=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_REGION_ID=cn-hangzhou
# production/staging is restricted to the official HTTPS host. Override only for local tests.
SMS_API_ENDPOINT=https://dysmsapi.aliyuncs.com/
OTP_TTL_SECONDS=300
OTP_SEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_ATTEMPTS=5
SMS_IP_RATE_LIMIT_PER_MINUTE=30
SMS_DEVICE_RATE_LIMIT_PER_MINUTE=10

# development | wechat | alipay
PAYMENT_DEFAULT_PROVIDER=development
# direct | jeepay. Public provider names above stay unchanged in either mode.
PAYMENT_GATEWAY_MODE=direct
PAYMENT_DEVELOPMENT_ENABLED=true
PAYMENT_QUERY_RATE_LIMIT_PER_MINUTE=20
ORDER_EXPIRY_MINUTES=15
COMMISSION_HOLD_DAYS=7

WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_MERCHANT_SERIAL_NO=
WECHAT_API_V3_KEY=
WECHAT_API_V3_KEY_FILE=
WECHAT_PRIVATE_KEY=
WECHAT_PRIVATE_KEY_FILE=
WECHAT_PLATFORM_CERTIFICATE=
WECHAT_PLATFORM_CERTIFICATE_FILE=
# Public HTTPS callback URLs; userinfo and fragments are rejected in production/staging.
WECHAT_NOTIFY_URL=
WECHAT_REFUND_NOTIFY_URL=
# Official host is mandatory in production/staging. Override only for local mock tests.
WECHAT_API_BASE_URL=https://api.mch.weixin.qq.com

ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
# AI 网页应用收款（非 Java）使用应用 PKCS8 私钥签名，支付宝公钥验签。
ALIPAY_PRIVATE_PKCS_KEY=
ALIPAY_PRIVATE_PKCS_KEY_FILE=
ALIPAY_ALIPAY_PUBLIC_KEY=
ALIPAY_ALIPAY_PUBLIC_KEY_FILE=
# 旧部署兼容项；新配置不要使用，尤其不要把“应用公钥”误填为支付宝公钥。
ALIPAY_PRIVATE_KEY=
ALIPAY_PRIVATE_KEY_FILE=
ALIPAY_PUBLIC_KEY=
ALIPAY_PUBLIC_KEY_FILE=
# Public HTTPS callback URL; userinfo and fragments are rejected in production/staging.
ALIPAY_NOTIFY_URL=
# 正式环境使用 openapi.alipay.com；沙箱测试改为
# https://openapi-sandbox.dl.alipaydev.com/gateway.do。
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do

# Jeepay merchant API (server-side only). Enable this block instead of the
# direct WeChat/Alipay credentials when PAYMENT_GATEWAY_MODE=jeepay.
JEEPAY_ENABLED=false
# Enable each channel only after its Jeepay interface config, passage and live
# payment/refund checks have passed. The two switches are intentionally separate.
JEEPAY_ALIPAY_ENABLED=false
JEEPAY_WECHAT_ENABLED=false
JEEPAY_API_BASE_URL=http://127.0.0.1:9216
JEEPAY_MCH_NO=
JEEPAY_APP_ID=
JEEPAY_API_KEY=
JEEPAY_API_KEY_FILE=
JEEPAY_NOTIFY_URL=
JEEPAY_REFUND_NOTIFY_URL=
JEEPAY_ALIPAY_WAY_CODE=ALI_QR
JEEPAY_WECHAT_WAY_CODE=WX_NATIVE
JEEPAY_CLIENT_IP=127.0.0.1
JEEPAY_CALLBACK_MAX_AGE_SECONDS=600

# Before first local/server start, run:
#   python scripts/generate_ed25519_key.py --output-dir .secrets
# Keep this private key stable and outside source control; replacing it invalidates offline tokens.
# PEM encoded Ed25519 PKCS8 private key. *_FILE takes precedence.
OFFLINE_SIGNING_PRIVATE_KEY=
OFFLINE_SIGNING_PRIVATE_KEY_FILE=.secrets/offline_ed25519_private.pem
OFFLINE_SIGNING_KEY_ID=license-center-v1

# Dedicated protected-compute Ed25519 key. Never reuse or package the offline-license key.
# Generate with: python scripts/generate_protected_compute_key.py --output-dir .secrets
PROTECTED_COMPUTE_SIGNING_PRIVATE_KEY=
PROTECTED_COMPUTE_SIGNING_PRIVATE_KEY_FILE=.secrets/protected_compute_ed25519_private.pem
PROTECTED_COMPUTE_SIGNING_KEY_ID=protected-compute-v1
PROTECTED_COMPUTE_RESULT_TTL_SECONDS=300
PROTECTED_COMPUTE_OFFLINE_SECONDS=300
PROTECTED_COMPUTE_REQUEST_SKEW_SECONDS=60
PROTECTED_COMPUTE_RATE_LIMIT_PER_MINUTE=60
PROTECTED_COMPUTE_REVOCATION_EPOCH=0
PROTECTED_COMPUTE_REVOKED_KEY_IDS=
PROTECTED_COMPUTE_REVOKED_CAPABILITIES=

# Dynamic settlement for the built-in text relay. The upstream labels wallet
# credits as USD, but this account currently buys them 1:1 with CNY.
PAID_TEXT_CREDIT_CNY_MICROS=1000000
PAID_TEXT_USAGE_POLL_ATTEMPTS=8
PAID_TEXT_USAGE_POLL_INTERVAL_MS=400
# Reservation ceiling only; final charge always uses the measured request cost.
PAID_TEXT_RESERVATION_MULTIPLIER_PPM=1250000
PAID_IMAGE_CREDIT_CNY_MICROS=8696
PAID_IMAGE_CREDIT_SCALE=10000
PAID_IMAGE_RESERVATION_MULTIPLIER_PPM=2000000

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
AUTH_RATE_LIMIT_PER_MINUTE=30
LICENSE_RATE_LIMIT_PER_MINUTE=120
ONLINE_WINDOW_MINUTES=390
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
