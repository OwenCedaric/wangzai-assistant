<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeFrameworkVersion>8.0.29</RuntimeFrameworkVersion>
    <SelfContained>false</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CandidateRoot Condition="'$(CandidateRoot)' == ''">$(MSBuildThisFileDirectory)../Wangzai.CefBrowserHost/publish</CandidateRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../Wangzai.CefBrowserHost/CrossBorderBuiltInRuntime.cs" Link="Production/CrossBorderBuiltInRuntime.cs" />
    <Compile Include="../Wangzai.CefBrowserHost/BrowserProfile.cs" Link="Production/BrowserProfile.cs" />
    <Compile Include="../Wangzai.CefBrowserHost/ErrorCode.cs" Link="Production/ErrorCode.cs" />
    <Compile Include="../Wangzai.CefBrowserHost/JsonDefaults.cs" Link="Production/JsonDefaults.cs" />
    <Compile Include="../Wangzai.CefBrowserHost/Alibaba1688OrderNetworkCapture.cs" Link="Production/Alibaba1688OrderNetworkCapture.cs" />
    <Reference Include="CefSharp"><HintPath>$(CandidateRoot)/CefSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="CefSharp.Core"><HintPath>$(CandidateRoot)/CefSharp.Core.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
