# Development Compose only. Copy to .env and choose your own password.
POSTGRES_PASSWORD=replace-with-a-local-development-password
APP_NAME=License Center
APP_ENV=development
DEBUG=false
DOCS_ENABLED=true
DATABASE_URL=postgresql+psycopg://license_center:license_center@127.0.0.1:5432/license_center
SQL_ECHO=false
AUTO_CREATE_TABLES=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_REQUIRED=false
JWT_SECRET_KEY=change-me-to-a-random-value-with-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=license-center
JWT_AUDIENCE=license-center-clients
ACCESS_TOKEN_MINUTES=60
LICENSE_TOKEN_HOURS=24
OFFLINE_GRACE_HOURS=72
CARD_HASH_SECRET=change-me-to-an-independent-stable-32-character-secret
CARD_ENCRYPTION_KEY=
OFFLINE_SIGNING_PRIVATE_KEY=
OFFLINE_SIGNING_KEY_ID=license-center-v1
PROTECTED_COMPUTE_SIGNING_PRIVATE_KEY=
PROTECTED_COMPUTE_SIGNING_PRIVATE_KEY_FILE=.secrets/protected_compute_ed25519_private.pem
PROTECTED_COMPUTE_SIGNING_KEY_ID=protected-compute-v1
PROTECTED_COMPUTE_RESULT_TTL_SECONDS=300
PROTECTED_COMPUTE_OFFLINE_SECONDS=300
PROTECTED_COMPUTE_REQUEST_SKEW_SECONDS=60
PROTECTED_COMPUTE_RATE_LIMIT_PER_MINUTE=60
PROTECTED_COMPUTE_REVOCATION_EPOCH=0
PAID_CAPABILITY_ENABLED=false
PAID_CAPABILITY_QUOTE_TTL_SECONDS=120
PAID_CAPABILITY_REQUEST_SKEW_SECONDS=60
PAID_CAPABILITY_RATE_LIMIT_PER_MINUTE=60
PAID_TEXT_BASE_URL=https://api.openai.com/v1
PAID_TEXT_API_KEY_FILE=
PAID_IMAGE_BASE_URL=https://api.openai.com/v1
PAID_IMAGE_API_KEY_FILE=
PAID_SEERFAR_BASE_URL=https://api.seerfar.cn
PAID_SEERFAR_API_KEY_FILE=
PAID_PROVIDER_ALLOWED_HOSTS=api.openai.com,api.seerfar.cn
# Only exact private OSS/CDN hosts that serve paid image-edit sources.
PAID_SOURCE_IMAGE_ALLOWED_HOSTS=
PAID_PROVIDER_TIMEOUT_SECONDS=150
API_POOL_HASH_SECRET_FILE=/run/secrets/api_pool_hash_secret
API_POOL_ENCRYPTION_KEY_FILE=/run/secrets/api_pool_encryption_key
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
TRUSTED_HOSTS=localhost,127.0.0.1
AUTH_RATE_LIMIT_PER_MINUTE=30
LICENSE_RATE_LIMIT_PER_MINUTE=120
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
