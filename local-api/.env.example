# Local development only. Production values belong in the server secret store.
ALIYUN_OSS_REGION=oss-cn-hongkong
ALIYUN_OSS_BUCKET=replace-with-private-bucket
ALIYUN_OSS_ENDPOINT=https://oss-cn-hongkong.aliyuncs.com
ALIYUN_OSS_ACCELERATION_ENABLED=false
ALIYUN_OSS_ACCELERATE_ENDPOINT=https://oss-accelerate.aliyuncs.com
ALIYUN_OSS_PREFIX=wangzai/temp/
ALIYUN_OSS_PERMANENT_PREFIX=wangzai/assets/
ALIYUN_OSS_PREVIEW_URL_TTL_SECONDS=900
ALIYUN_OSS_OZON_URL_TTL_SECONDS=86400
ALIYUN_OSS_ACCESS_KEY_ID=replace-with-server-secret
ALIYUN_OSS_ACCESS_KEY_SECRET=replace-with-server-secret
PRODUCT_IMAGE_TEMPORARY_RETENTION_SECONDS=604800
PRODUCT_IMAGE_MAX_CONCURRENT=4
PRODUCT_IMAGE_MAX_CONCURRENT_PER_OWNER=2
PRODUCT_IMAGE_MAX_QUEUE=200
PRODUCT_IMAGE_MAX_DAILY_UPLOADS=2000
PRODUCT_IMAGE_MAX_DAILY_BYTES=2147483648
PRODUCT_IMAGE_MAX_RETAINED_BYTES=21474836480
PRODUCT_IMAGE_MAX_UPLOAD_ATTEMPTS=3
PRODUCT_IMAGE_RETRY_BASE_MS=250
PRODUCT_IMAGE_MONTHLY_BUDGET_CNY=100

# 图片权属证据链：默认启用；Ozon 只允许上传已完成本地校验的暗水印资产。
IMAGE_PROVENANCE_SHADOW_ENABLED=true
# 留空时自动放在当前 SQLite 数据目录旁的 image-provenance 文件夹。
IMAGE_PROVENANCE_EVIDENCE_ROOT=
IMAGE_PROVENANCE_ALGORITHM_VERSION=1.1.0-upload
IMAGE_PROVENANCE_DCT_STRENGTH=20
IMAGE_PROVENANCE_MAX_CONCURRENT=1
IMAGE_PROVENANCE_MAX_ATTEMPTS=3
IMAGE_PROVENANCE_SOURCE_WAIT_MS=150000
IMAGE_PROVENANCE_WORKER_TIMEOUT_MS=120000
IMAGE_PROVENANCE_PROTECTION_WAIT_MS=180000
